# ── Obligatoire ─────────────────────────────────────────────
# Token donné par @BotFather sur Telegram
TELEGRAM_TOKEN=
# Ton identifiant Telegram (envoie /id au bot pour le connaître). Plusieurs : 111,222
# Vide = mode configuration : le bot ne répond qu'à /id.
ALLOWED_USER_IDS=

# ── Cerveau (LLM local gratuit via Ollama) ──────────────────
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3:14b
# 1 = Jarvis décide seul entre répondre et agir ; 0 = uniquement via /do
AUTO_ROUTE=1
# 0 = réponses rapides (désactive la phase de « réflexion » de qwen3) ; 1 = plus réfléchi mais plus lent
CHAT_THINK=0

# ── Agents qui exécutent les tâches ─────────────────────────
# Déclare autant d'agents que tu veux : AGENT_<NOM>=commande ({prompt} = ta demande).
# Depuis le téléphone : /agent claude (bascule), /claude <tâche> ou « Claude, … » (une fois).
#
# 100 % gratuit, local (OpenCode + Ollama) :
AGENT_LOCAL=opencode run -m ollama/qwen3-coder:30b {prompt}
# Variante plus rapide (tient entièrement dans 16 Go de VRAM), un peu moins forte en code :
# AGENT_RAPIDE=opencode run -m ollama/gpt-oss:20b {prompt}
# Claude Code avec ton ABONNEMENT (fais `claude login` une fois sur le PC).
# Jarvis retire ANTHROPIC_API_KEY de son environnement : jamais de facturation API.
AGENT_CLAUDE=claude -p {prompt} --dangerously-skip-permissions
# Autre option gratuite (Aider + Ollama) :
# AGENT_AIDER=aider --model ollama_chat/qwen2.5-coder:14b --yes-always --no-check-update --message {prompt}

# Agent utilisé quand tu n'en précises pas (le premier déclaré sinon)
DEFAULT_AGENT=local

# Dossier où Jarvis crée/modifie des projets (un sous-dossier par projet)
WORKSPACE=~/jarvis-workspace
# Nombre de tâches simultanées (1 conseillé : le GPU est partagé)
MAX_PARALLEL_TASKS=1
# Mise à jour du message de suivi d'une tâche toutes les N minutes (0 = jamais)
PROGRESS_MINUTES=5

# ── Recherche web (SearXNG auto-hébergé, voir deploy/searxng.container) ──
# Vide = désactivée. Le script d'installation Fedora la configure si tu le souhaites.
SEARXNG_URL=

# ── Vocal (nécessite: pip install faster-whisper) ───────────
WHISPER_MODEL=small

# ── Voix de Jarvis (Piper, local et gratuit : pip install piper-tts, + ffmpeg pour de vrais vocaux) ──
# off = jamais · rappels = rappels, focus, briefing, bilan · tout = aussi les réponses (/voix pour changer)
VOICE_MODE=rappels
TTS_VOICE=fr_FR-siwis-medium
# 1 = lire aussi les rappels et fins de focus sur les haut-parleurs du PC
PC_AUDIO=0

# ── Productivité ────────────────────────────────────────────
FOCUS_MINUTES=25
BREAK_MINUTES=5
# Bilan du soir automatique (vide = désactivé ; /bilan marche toujours)
REVIEW_TIME=20:30

# ── Relances et heures de travail ────────────────────────────
# Relance si ta tâche prioritaire n'avance pas depuis N heures (0 = jamais)
NUDGE_HOURS=2
# Relances et /bloquer seulement dans ces heures et ces jours (1 = lundi … 7 = dimanche)
WORK_HOURS=9-19
WORK_DAYS=1-5

# ── Agenda (lecture seule) ──────────────────────────────────
# Google Agenda, sur ordinateur : Paramètres → ton agenda → « Adresse secrète au format iCal ».
# Plusieurs agendas : séparés par des virgules. Garde ces adresses secrètes !
CALENDAR_ICS_URLS=
# Rappel avant chaque rendez-vous (minutes)
EVENT_REMINDER_MINUTES=15

# ── Briefing quotidien ──────────────────────────────────────
# Heure d'envoi automatique (vide = désactivé ; /briefing marche toujours)
BRIEFING_TIME=07:30
TIMEZONE=Europe/Paris
CITY=Paris
LATITUDE=48.8566
LONGITUDE=2.3522
FEEDS=https://www.lemonde.fr/rss/une.xml,https://www.francetvinfo.fr/titres.rss
