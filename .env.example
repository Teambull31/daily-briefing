# ── Obligatoire ─────────────────────────────────────────────
# Token donné par @BotFather sur Telegram
TELEGRAM_TOKEN=
# Ton identifiant Telegram (envoie /id au bot pour le connaître). Plusieurs : 111,222
# Vide = mode configuration : le bot ne répond qu'à /id.
ALLOWED_USER_IDS=

# ── Cerveau (LLM local gratuit via Ollama) ──────────────────
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3:14b
# 1 = Jarvis décide seul entre répondre et agir ; 0 = uniquement via /do
AUTO_ROUTE=1

# ── Agents qui exécutent les tâches ─────────────────────────
# Déclare autant d'agents que tu veux : AGENT_<NOM>=commande ({prompt} = ta demande).
# Depuis le téléphone : /agent claude (bascule), /claude <tâche> ou « Claude, … » (une fois).
#
# 100 % gratuit, local (OpenCode + Ollama) :
AGENT_LOCAL=opencode run -m ollama/qwen3-coder:30b {prompt}
# Claude Code avec ton ABONNEMENT (fais `claude login` une fois sur le PC).
# Jarvis retire ANTHROPIC_API_KEY de son environnement : jamais de facturation API.
AGENT_CLAUDE=claude -p {prompt} --dangerously-skip-permissions
# Autre option gratuite (Aider + Ollama) :
# AGENT_AIDER=aider --model ollama_chat/qwen2.5-coder:14b --yes-always --no-check-update --message {prompt}

# Agent utilisé quand tu n'en précises pas (le premier déclaré sinon)
DEFAULT_AGENT=local

# Dossier où Jarvis crée/modifie des projets (un sous-dossier par projet)
WORKSPACE=~/jarvis-workspace
# Nombre de tâches simultanées (1 conseillé : le GPU est partagé)
MAX_PARALLEL_TASKS=1

# ── Vocal (nécessite: pip install faster-whisper) ───────────
WHISPER_MODEL=small

# ── Briefing quotidien ──────────────────────────────────────
# Heure d'envoi automatique (vide = désactivé ; /briefing marche toujours)
BRIEFING_TIME=07:30
TIMEZONE=Europe/Paris
CITY=Paris
LATITUDE=48.8566
LONGITUDE=2.3522
FEEDS=https://www.lemonde.fr/rss/une.xml,https://www.francetvinfo.fr/titres.rss
